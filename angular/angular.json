{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "destroyOceanCity": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/destroyOceanCity",
              "browser": ""
            },
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/bootstrap-icons/font/bootstrap-icons.css",
              "src/styles.css",
              "src/app/animations/skeleton-shimmer-loading.css",
              {
                "input": "src/bs-custom-light.scss",
                "bundleName": "theme-light",
                "inject": false
              },
              {
                "input": "src/bs-custom-dark.scss",
                "bundleName": "theme-dark",
                "inject": false
              }
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "styles": [
                "src/bs-custom-light.scss",
                "src/styles.css"
              ],
              "polyfills": [
                "zone.js",
                "zone.js/testing"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "destroyOceanCity:build:production"
            },
            "development": {
              "buildTarget": "destroyOceanCity:build:development",
              "proxyConfig": "proxy.conf.json",
              "port": 4400,
              "host": "localhost"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        }
      }
    }
  }
}
